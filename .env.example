# Copy to .env and set real values. Never commit secrets.
SECRET_KEY=replace-this-with-a-secure-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com
DATABASE_URL=postgres://bjsuser:bjspassword@db:5432/bjsdb
BOOTSTRAP_SUPERADMIN=False
BOOTSTRAP_SUPERADMIN_USERNAME=admin
# If enabling bootstrap, set a strong password via secret management
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEFAULT_FROM_EMAIL=webmaster@yourdomain.com
# Optional: enable S3 for media
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
